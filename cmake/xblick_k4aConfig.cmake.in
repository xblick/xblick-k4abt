# xblick_k4a: the libraries of xblick-azure-kinect (CMakeLists.txt). Targets xblick_k4a::xblick_k4a
# (the node, its sources and the depth engine's EGL context) and, if built with body tracking,
# xblick_k4a::xblick_k4abt. Variables xblick_k4a_CUDA and xblick_k4a_BODY_TRACKING: what was built.
@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
set(xblick_k4a_CUDA @XBLICK_K4A_CUDA@)
set(xblick_k4a_BODY_TRACKING @XBLICK_K4A_BODY_TRACKING@)
find_dependency(xblick 0.5)
find_dependency(k4a 1.4)
find_dependency(k4arecord 1.4)
find_dependency(nlohmann_json 3)
find_dependency(JPEG)
if(xblick_k4a_CUDA)
  find_dependency(CUDAToolkit 12)
endif()
if(xblick_k4a_BODY_TRACKING)
  find_dependency(k4abt 1.1)
endif()
include("${CMAKE_CURRENT_LIST_DIR}/xblick_k4aTargets.cmake")
check_required_components(xblick_k4a)
